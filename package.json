{
  "name": "agentia",
  "version": "0.1.0",
  "description": "AI-powered integrated development environment",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "fmt:rust": "cd src-tauri && cargo fmt",
    "lint:rust": "cd src-tauri && cargo clippy -- -D warnings",
    "check:rust": "cd src-tauri && cargo check",
    "fmt:ts": "prettier --write .",
    "lint:ts": "eslint .",
    "check:ts": "eslint . && prettier --check .",
    "fmt": "pnpm fmt:ts && pnpm fmt:rust",
    "lint": "pnpm lint:ts && pnpm check && pnpm lint:rust",
    "prepare": "lefthook install",
    "reset-db": "./scripts/reset-db.sh"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.3.0",
    "@tauri-apps/plugin-opener": "^2",
    "highlight.js": "^11.11.1",
    "lucide-svelte": "^0.525.0",
    "marked": "^16.0.0",
    "marked-highlight": "^2.2.2"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.1.11",
    "@tauri-apps/cli": "^2",
    "@typescript-eslint/eslint-plugin": "^8.36.0",
    "@typescript-eslint/parser": "^8.36.0",
    "bits-ui": "1.0.0-next.98",
    "clsx": "^2.1.1",
    "eslint": "^9.30.1",
    "eslint-plugin-svelte": "^3.10.1",
    "lefthook": "^1.12.1",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "shadcn-svelte": "1.0.0-next.19",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}
